.551 53.471,12.396L53.759,11.917H49.395L48.764,12.969C48.47,13.461 48.863,13.994 49.362,13.994H57.517C58.165,13.994 58.743,13.654 59.054,13.134L60.41,10.877C60.723,10.356 60.327,9.843 59.824,9.843L59.821,9.846Z M45.882,8.482C45.763,8.676 43.475,12.481 43.475,12.481C43.356,12.684 43.121,12.817 42.867,12.817H42.11C41.865,12.817 41.756,12.56 41.849,12.405L44.265,8.39C44.401,8.169 44.652,8.061 44.867,8.061H45.627C45.845,8.061 45.997,8.289 45.878,8.482H45.882ZM49.987,6.881H41.839C41.247,6.881 40.636,7.186 40.318,7.712L37.135,12.998C36.854,13.464 37.241,14 37.743,14H45.905C46.562,14 47.138,13.645 47.425,13.169L50.605,7.886C50.88,7.433 50.529,6.881 49.987,6.881Z M35.28,8.479L34.659,9.513C34.514,9.754 34.269,9.846 34.057,9.846H31.747L32.821,8.061H35.026C35.254,8.061 35.389,8.295 35.28,8.479ZM33.495,11.45L32.874,12.484C32.729,12.725 32.484,12.817 32.276,12.817H29.965L31.039,11.032H33.244C33.472,11.032 33.608,11.267 33.499,11.45H33.495ZM36.454,10.439C37.052,10.439 37.657,10.097 37.951,9.611L38.983,7.889C39.254,7.442 38.923,6.881 38.381,6.881H29.175L25.602,12.817H17.331V14H34.285C34.904,14 35.489,13.692 35.813,13.153L36.867,11.397C37.085,11.029 36.854,10.563 36.447,10.442L36.454,10.439Z M79,8.061V6.878H64.042L59.758,14H70.141L70.855,12.817H64.829L65.903,11.032H71.929L72.64,9.846H66.614L67.692,8.061H79Z"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Viewbox>
                                    </Grid>
                                </Grid>
                                <StackPanel
                                    x:Name="DeviceBatteryRegion"
                                    Grid.Row="1"
                                    Width="360"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    AutomationProperties.AutomationId="BatterySummaryText"
                                    AutomationProperties.Name="{x:Bind ViewModel.BatterySummaryText, Mode=OneWay}">
                                    <TextBlock x:Uid="DeviceBatteryTitle" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Padding="4,16">
                                            <StackPanel Spacing="8">
                                                <TextBlock x:Uid="LeftBatteryLabel" AutomationProperties.AutomationId="ControlBatteryLeftLabel" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Grid HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="24" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        TextAlignment="Center"
                                                        AutomationProperties.AutomationId="ControlBatteryLeft"
                                                        Text="{x:Bind ViewModel.LeftBatteryText, Mode=OneWay}"
                                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                                    <FontIcon
                                                        Grid.Column="2"
                                                        AutomationProperties.AutomationId="ControlChargingLeft"
                                                        AutomationProperties.Name="{x:Bind ViewModel.ChargingLabel, Mode=OneWay}"
                                                        Glyph="&#xE945;"
                                                        FontSize="16"
                                                        ToolTipService.ToolTip="{x:Bind ViewModel.ChargingLabel, Mode=OneWay}"
