                                <ComboBox
                                    x:Name="BoseLogoModeSelector"
                                    AutomationProperties.AutomationId="BoseLogoModeSelector"
                                    SelectionChanged="OnBoseLogoModeSelectionChanged">
                                    <ComboBoxItem x:Uid="BoseLogoOff" AutomationProperties.AutomationId="BoseLogoOff" Tag="Off" />
                                    <ComboBoxItem x:Uid="BoseLogoByModel" AutomationProperties.AutomationId="BoseLogoByModel" Tag="ByModel" />
                                    <ComboBoxItem x:Uid="BoseLogoAlways" AutomationProperties.AutomationId="BoseLogoAlways" Tag="Always" />
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="LanguageCard">
                                <TextBlock x:Uid="LanguageValue" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="PrivacyCard" ContentAlignment="Left">
                                <TextBlock x:Uid="PrivacyValue" TextWrapping="Wrap" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="AboutCard" ContentAlignment="Left">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="AboutVersionText"
                                        AutomationProperties.AutomationId="AboutVersionText"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="UnofficialNotice" TextWrapping="Wrap" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </NavigationView>

        <ContentDialog
            x:Name="FitTestDialog"
            x:Uid="FitTestDialog"
            AutomationProperties.AutomationId="FitTestDialog"
            Closing="OnFitTestDialogClosing"
            DefaultButton="None">
            <StackPanel Spacing="18">
                <TextBlock
                    x:Uid="FitTestDialogIntro"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon
                                AutomationProperties.Name="{x:Bind ViewModel.LeftFitTestStatusText, Mode=OneWay}"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="28"
                                Glyph="{x:Bind local:MainPage.FitTestStatusGlyph(ViewModel.LeftFitTestStatus), Mode=OneWay}" />
                            <TextBlock x:Uid="FitTestLeftLabel" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="FitTestLeftStatus"
                                Text="{x:Bind ViewModel.LeftFitTestStatusText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon
                                AutomationProperties.Name="{x:Bind ViewModel.RightFitTestStatusText, Mode=OneWay}"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="28"
                                Glyph="{x:Bind local:MainPage.FitTestStatusGlyph(ViewModel.RightFitTestStatus), Mode=OneWay}" />
                            <TextBlock x:Uid="FitTestRightLabel" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="FitTestRightStatus"
                                Text="{x:Bind ViewModel.RightFitTestStatusText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <ProgressRing
                        Width="32"
                        Height="32"
                        AutomationProperties.AutomationId="FitTestProgress"
                        IsActive="{x:Bind ViewModel.IsFitTestActive, Mode=OneWay}"
                        Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsFitTestActive), Mode=OneWay}" />
                    <TextBlock
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="FitTestResultMessage"
                        Text="{x:Bind ViewModel.FitTestResultMessage, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.AutomationId="FitTestStartButton"
                        Click="OnFitTestStartClick"
                        Content="{x:Bind ViewModel.FitTestActionText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanStartFitTest, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        x:Uid="FitTestStopButton"
                        AutomationProperties.AutomationId="FitTestStopButton"
                        Click="OnFitTestStopClick"
                        IsEnabled="{x:Bind ViewModel.IsFitTestActive, Mode=OneWay}"
                        Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsFitTestActive), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
