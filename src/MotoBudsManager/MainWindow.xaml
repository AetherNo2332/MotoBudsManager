<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MotoBudsManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MotoBudsManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    Title="Moto Buds Manager"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="ms-appx:///Assets/AppIcon.ico"
            LeftClickCommand="{x:Bind RestoreWindowCommand}"
            MenuActivation="RightClick"
            ToolTipText="Moto Buds Manager">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="TrayOpenMenuItem" Command="{x:Bind RestoreWindowCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="TrayExitMenuItem" Command="{x:Bind ExitApplicationCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <TitleBar x:Name="AppTitleBar" Title="Moto Buds Manager">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIconTitleBar.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
